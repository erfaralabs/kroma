<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Framework Material (dark) theme so the camera UI is dark edge-to-edge without
         pulling in the Material Components dependency; Compose paints its own surface. -->
    <style name="Theme.Kroma" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
